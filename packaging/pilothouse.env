# Environment file for pilothouse.service — the unprivileged web console.
#
# The unit references this file as `EnvironmentFile=-/etc/pilothouse/pilothouse.env`,
# so it is optional and every line below is deliberately commented out:
# installing the package changes no runtime behavior. Uncomment and edit a
# line to override a default.
#
# Trusted browser-visible origins, comma separated. Set this when a reverse
# proxy rewrites the upstream Host header, so the console accepts requests
# whose Origin or Referer names the public address rather than the listen
# address. The value is merged with any --allowed-origin flag the unit's
# ExecStart passes; the flag is repeatable and this variable is its
# comma-separated equivalent. An https:// origin also enables secure session
# cookies on its own.
#
#PILOTHOUSE_ALLOWED_ORIGINS=https://admin.example.test

# Listen address for the web console. The built-in default is loopback-only
# (127.0.0.1:8888). Binding a non-loopback address without TLS material
# below auto-generates a persistent self-signed certificate under the
# unit's state directory (/var/lib/pilothouse/web) and serves HTTPS. A
# --listen flag in ExecStart would override this variable; the packaged
# unit deliberately passes none.
#
#PILOTHOUSE_LISTEN=0.0.0.0:8888

# Operator-supplied TLS material for the web console. Set both or neither;
# setting them serves HTTPS on any listen address and disables self-signed
# generation. The pilothouse user must be able to read both files.
#
#PILOTHOUSE_TLS_CERT=/etc/pilothouse/tls/console.crt
#PILOTHOUSE_TLS_KEY=/etc/pilothouse/tls/console.key

# Explicit acknowledgment to serve plaintext HTTP on a non-loopback
# address (for example behind a TLS-terminating reverse proxy on another
# host, or on a trusted overlay network that already encrypts transport).
# Without this, a non-loopback bind with no TLS material uses the
# self-signed certificate instead. Credentials and session cookies travel
# unencrypted when this is enabled.
#
#PILOTHOUSE_ALLOW_INSECURE_HTTP=1
