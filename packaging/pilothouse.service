[Unit]
Description=Pilothouse web console
After=network.target pilothoused.service
Requires=pilothoused.service

[Service]
Type=simple
EnvironmentFile=-/etc/pilothouse/pilothouse.env
ExecStart=/usr/bin/pilothouse --broker-socket /run/pilothouse/broker.sock
Restart=on-failure
RestartSec=3
User=pilothouse
Group=pilothouse
StateDirectory=pilothouse/web
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
