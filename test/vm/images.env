# Pinned cloud images for the booted-VM harness (Layer B, #67).
#
# This file is the single pinning site for the guest images: the workflow and
# the harness scripts carry no URL and no digest of their own. It is parsed as
# inert data by test/vm/lib/images.sh; keep it to unique plain
# `NAME="value"` assignments.
#
# Rules that hold for every entry here:
#
#   * amd64/x86_64 only. The runner is x86_64 and KVM needs the guest
#     architecture to match the host.
#   * Immutable, dated or archived paths only. A `latest`-style URL would
#     defeat the checksum pin.
#   * The algorithm and digest are the distributor's own published values,
#     never a digest computed here.
#
# Debian 12 (bookworm) genericcloud, amd64. The digest is the qcow2's entry in
# SHA512SUMS in the same dated directory.
VM_IMAGE_DEBIAN_URL="https://cloud.debian.org/images/cloud/bookworm/20260722-2547/debian-12-genericcloud-amd64-20260722-2547.qcow2"
VM_IMAGE_DEBIAN_ALGORITHM="sha512"
VM_IMAGE_DEBIAN_DIGEST="ddc98e22b1c0e6647369fba51e285af155f3f19438f372577fb148817e586eed10526240aa71abc44a836679bf6f8c70ba3d092d945989905abc0c81907b97b0"

# Fedora 42 Cloud-Base-Generic, x86_64. Fedora 42 is archived, so this is the
# `pub/archive/...` path: the non-archive `releases/42/...` path returns 404.
# The digest is the qcow2's entry in Fedora-Cloud-42-1.1-x86_64-CHECKSUM in the
# same directory.
VM_IMAGE_FEDORA_URL="https://dl.fedoraproject.org/pub/archive/fedora/linux/releases/42/Cloud/x86_64/images/Fedora-Cloud-Base-Generic-42-1.1.x86_64.qcow2"
VM_IMAGE_FEDORA_ALGORITHM="sha256"
VM_IMAGE_FEDORA_DIGEST="e401a4db2e5e04d1967b6729774faa96da629bcf3ba90b67d8d9cce9906bec0f"
