package sysext

import (
	"fmt"

	"github.com/frostyard/pilothouse/internal/web"
)

templ Summary(state ExtensionsState) {
	<article class="card">
		<div class="card-heading split">
			<div><h2>System extensions</h2><p>{ fmt.Sprintf("%d active · %d available", mergedCount(state.Extensions), len(state.Extensions)) }</p></div>
			<a class="card-link" href="/sysext">
				Manage
				@web.Icon("chevron")
			</a>
		</div>
		<div class="mini-list">
			<div class="mini-row"><div><strong>Updates</strong><small>Enabled system extensions</small></div><span class="badge">{ fmt.Sprint(updateCount(state.Extensions)) }</span></div>
			for index, extension := range activeFirst(state.Extensions) {
				if index < 4 {
					<div class="mini-row">
						<div><strong>{ extension.Name }</strong><small>{ extension.Description }</small></div>
						if extension.Merged {
							<span class="badge active">Active</span>
						} else if extension.Enabled {
							<span class="badge update">Enabled</span>
						} else {
							<span class="badge">Available</span>
						}
					</div>
				}
			}
		</div>
	</article>
}

// Page renders the Extensions surface. The three availability flags are
// computed once by the GET /sysext handler from a single
// host.Capabilities read, and each one collapses every control targeting
// the route it names — enableDisableAvailable covers both the per-row
// enable form and the per-row disable form (they share one gated route
// family), refreshAvailable covers the refresh form, and updateAvailable
// covers the update form. An extension with Managed=false renders no
// enable/disable control regardless of the flags: unmanaged extensions
// have no updex definition, so the broker could not act on them even
// where both tools are present.
templ Page(state ExtensionsState, csrf string, admin bool, enableDisableAvailable bool, refreshAvailable bool, updateAvailable bool) {
	<div class="page-stack">
		<div class="page-intro">
			<p>Optional Snosi software layers managed through updex. Enabling downloads and merges the newest extension; removing an active extension disables it now and takes effect on reboot.</p>
			if !admin {
				<span class="badge">Read only</span>
			} else if refreshAvailable || updateAvailable {
				<div class="actions">
					if refreshAvailable {
						<form method="post" action="/sysext/actions/refresh" hx-boost="false">
							<input type="hidden" name="csrf" value={ csrf }/>
							<button class="button secondary" type="submit">
								@web.Icon("refresh")
								Refresh merge
							</button>
						</form>
					}
					if updateAvailable {
						<form method="post" action="/sysext/actions/update" hx-boost="false">
							<input type="hidden" name="csrf" value={ csrf }/>
							<button class="button" type="submit">Update enabled</button>
						</form>
					}
				</div>
			}
		</div>
		<article class="card table-card">
			<div class="table-toolbar"><h2>Available extensions</h2><span>{ fmt.Sprintf("%d enabled", enabledCount(state.Extensions)) }</span></div>
			if len(state.Extensions) == 0 {
				<div class="empty-state"><span class="card-icon">@web.Icon("sysext")</span>No extension definitions were found.</div>
			} else {
				<table class="data-table">
					<thead><tr><th>Extension</th><th>Status</th><th>Version</th><th></th></tr></thead>
					<tbody>
						for _, extension := range state.Extensions {
							<tr>
								<td>
									<div class="extension-name"><span class="card-icon">@web.Icon("sysext")</span><div><strong>{ extension.Name }</strong><small>{ extension.Description }</small></div></div>
								</td>
								<td>
									if extension.Merged {
										<span class="badge active">Active</span>
									} else if extension.Enabled {
										<span class="badge update">Enabled</span>
									} else {
										<span class="badge">Available</span>
									}
									if len(extension.Updates) > 0 {
										<span class="badge update">Update available</span>
									}
								</td>
								<td><span class="version">{ extension.Version }</span></td>
								<td>
									<div class="actions">
										if !admin {
											<span class="card-subtle">No permission</span>
										} else if !extension.Managed {
											<span class="card-subtle">Unmanaged</span>
										} else if !enableDisableAvailable {
											<span class="card-subtle">Unavailable</span>
										} else if extension.Enabled || extension.Installed {
											<form method="post" action={ templ.SafeURL("/sysext/" + extension.Name + "/disable") } hx-boost="false">
												<input type="hidden" name="csrf" value={ csrf }/>
												if extension.Merged {
													<button class="button danger" type="submit">Remove at reboot</button>
												} else {
													<button class="button danger" type="submit">Remove</button>
												}
											</form>
										} else {
											<form method="post" action={ templ.SafeURL("/sysext/" + extension.Name + "/enable") } hx-boost="false">
												<input type="hidden" name="csrf" value={ csrf }/>
												<button class="button" type="submit">Install</button>
											</form>
										}
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</article>
		<article class="card table-card">
			<div class="table-toolbar"><h2>Available updates</h2><span>{ fmt.Sprintf("%d pending", updateCount(state.Extensions)) }</span></div>
			if updateCount(state.Extensions) == 0 {
				<div class="empty-state"><span class="card-icon green">@web.Icon("check")</span>Enabled extensions are up to date.</div>
			} else {
				<table class="data-table">
					<thead><tr><th>Extension</th><th>Component</th><th>Current</th><th>Newest</th></tr></thead>
					<tbody>
						for _, update := range pendingUpdates(state.Extensions) {
							<tr><td><strong>{ update.Extension }</strong></td><td>{ update.Component }</td><td>{ update.Current }</td><td>{ update.Newest }</td></tr>
						}
					</tbody>
				</table>
			}
		</article>
	</div>
}
