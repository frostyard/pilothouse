package incus

import (
	"fmt"

	"github.com/frostyard/pilothouse/internal/web"
)

templ Summary(state State) {
	<article class="card">
		<div class="card-heading split">
			<div><h2>Incus</h2><p>{ fmt.Sprintf("%d running · %d instances", runningCount(state), len(state.Instances)) }</p></div>
			<a class="card-link" href="/incus">
				Manage
				@web.Icon("chevron")
			</a>
		</div>
		if len(state.Instances) == 0 {
			<div class="empty-state compact">
				<span class="card-icon orange">@web.Icon("incus")</span>
				No local Incus instances.
			</div>
		} else {
			<div class="mini-list">
				for index, instance := range state.Instances {
					if index < 4 {
						<div class="mini-row">
							<div><strong>{ instance.Name }</strong><small>{ instance.Type } · { instance.Image }</small></div>
							if instance.Running {
								<span class="badge active">Running</span>
							} else {
								<span class="badge">{ stateLabel(instance) }</span>
							}
						</div>
					}
				}
			</div>
		}
	</article>
}

templ Page(state State, csrf string, admin bool) {
	<div class="page-stack">
		<div class="page-intro incus-project-bar">
			<div><p>Containers and virtual machines from the selected local Incus project. Pilothouse uses the official SDK over the local Unix socket and never reads configured remotes.</p></div>
			<form method="get" action="/incus">
				<label for="incus-project">Project</label>
				<select id="incus-project" name="project" onchange="this.form.submit()">
					for _, project := range state.Projects {
						<option value={ project.Name } selected?={ project.Name == state.Project }>{ project.Name }</option>
					}
				</select>
				<noscript><button class="button secondary" type="submit">Select</button></noscript>
			</form>
			if admin {
				<span class="badge active">Administrator</span>
			} else {
				<span class="badge">Read only</span>
			}
		</div>
		<section class="engine-stats" aria-label="Incus summary">
			<div class="engine-stat"><span>Running</span><strong>{ fmt.Sprint(runningCount(state)) }</strong><small>of { fmt.Sprint(len(state.Instances)) } instances</small></div>
			<div class="engine-stat"><span>Stopped</span><strong>{ fmt.Sprint(len(state.Instances) - runningCount(state)) }</strong><small>instances</small></div>
			<div class="engine-stat"><span>Memory</span><strong>{ formatBytes(memoryBytes(state)) }</strong><small>in use</small></div>
			<div class="engine-stat"><span>Images</span><strong>{ fmt.Sprint(len(state.Images)) }</strong><small>{ formatBytes(imageBytes(state)) } local</small></div>
			<div class="engine-stat"><span>Engine</span><strong class="version">{ state.Version }</strong><small>Incus</small></div>
		</section>
		if len(state.Warnings) > 0 {
			<article class="card">
				<div class="card-heading"><h2>Partial inventory</h2></div>
				<ul class="notice-list">
					for _, warning := range state.Warnings {
						<li>{ warning }</li>
					}
				</ul>
			</article>
		}
		<article class="card table-card">
			<div class="table-toolbar"><h2>Instances</h2><span>{ fmt.Sprintf("%d total", len(state.Instances)) }</span></div>
			if len(state.Instances) == 0 {
				<div class="empty-state">
					<span class="card-icon orange">@web.Icon("incus")</span>
					No instances were found in the { state.Project } project.
				</div>
			} else {
				<table class="data-table">
					<thead><tr><th>Instance</th><th>Type</th><th>Address</th><th>Memory</th><th>Status</th><th></th></tr></thead>
					<tbody>
						for _, instance := range state.Instances {
							<tr>
								<td>
									<div class="extension-name">
										<span class="card-icon orange">@web.Icon("incus")</span>
										<div>
											<a href={ instanceLink(state.Project, instance.Name) }><strong>{ instance.Name }</strong></a>
											<small>{ instance.Image }</small>
										</div>
									</div>
								</td>
								<td>{ instance.Type }</td>
								<td>{ addressLabel(instance) }</td>
								<td>{ memoryLabel(instance) }</td>
								<td>
									if instance.Running {
										<span class="badge active">Running</span>
									} else {
										<span class="badge">{ stateLabel(instance) }</span>
									}
								</td>
								<td>
									<div class="actions">
										if !admin {
											<span class="card-subtle">No permission</span>
										} else if instance.Running {
											@instanceAction(state.Project, instance.Name, "restart", "Restart", csrf, "secondary")
											@instanceAction(state.Project, instance.Name, "stop", "Stop", csrf, "danger")
										} else {
											@instanceAction(state.Project, instance.Name, "start", "Start", csrf, "")
											@instanceAction(state.Project, instance.Name, "remove", "Remove", csrf, "danger")
										}
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</article>
		<article class="card table-card">
			<div class="table-toolbar"><h2>Images</h2><span>{ formatBytes(imageBytes(state)) } local</span></div>
			if len(state.Images) == 0 {
				<div class="empty-state">No images were found in the { state.Project } project.</div>
			} else {
				<table class="data-table"><thead><tr><th>Image</th><th>Fingerprint</th><th>Type</th><th>Instances</th><th>Size</th><th>Actions</th></tr></thead><tbody>
					for _, image := range state.Images {
						<tr><td><strong>{ image.Name }</strong></td><td><span class="version">{ shortID(image.Fingerprint) }</span></td><td>{ image.Type }</td><td>{ fmt.Sprint(image.Instances) }</td><td>{ formatBytes(image.Size) }</td><td>
							if !admin {
								<span class="card-subtle">No permission</span>
							} else if image.Instances == 0 {
								@imageAction(state.Project, image.Fingerprint, "remove", csrf, false, "Delete image")
							} else {
								@imageAction(state.Project, image.Fingerprint, "remove", csrf, true, fmt.Sprintf("In use by %d instance(s)", image.Instances))
							}
						</td></tr>
					}
				</tbody></table>
			}
		</article>
		<article class="card table-card">
			<div class="table-toolbar"><h2>Storage pools</h2><span>{ fmt.Sprintf("%d total", len(state.Pools)) }</span></div>
			if len(state.Pools) == 0 {
				<div class="empty-state"><span class="card-icon orange">@web.Icon("incus")</span>No storage pools were found.</div>
			} else {
				<table class="data-table"><thead><tr><th>Pool</th><th>Driver</th><th>Status</th><th>Used by</th></tr></thead><tbody>
					for _, pool := range state.Pools {
						<tr><td><strong>{ pool.Name }</strong></td><td>{ pool.Driver }</td><td><span class="badge">{ pool.Status }</span></td><td>{ fmt.Sprint(pool.UsedBy) }</td></tr>
					}
				</tbody></table>
			}
		</article>
		<article class="card table-card">
			<div class="table-toolbar"><h2>Storage volumes</h2><span>{ fmt.Sprintf("%d custom", len(state.Volumes)) }</span></div>
			if len(state.Volumes) == 0 {
				<div class="empty-state"><span class="card-icon orange">@web.Icon("incus")</span>No custom storage volumes were found in the { state.Project } project.</div>
			} else {
				<table class="data-table"><thead><tr><th>Volume</th><th>Pool</th><th>Type</th><th>Used by</th></tr></thead><tbody>
					for _, volume := range state.Volumes {
						<tr><td><strong>{ volume.Name }</strong></td><td>{ volume.Pool }</td><td>{ volume.ContentType }</td><td>{ fmt.Sprint(volume.UsedBy) }</td></tr>
					}
				</tbody></table>
			}
		</article>
		<article class="card table-card">
			<div class="table-toolbar"><h2>Storage buckets</h2><span>{ fmt.Sprintf("%d total", len(state.Buckets)) }</span></div>
			if len(state.Buckets) == 0 {
				<div class="empty-state"><span class="card-icon orange">@web.Icon("incus")</span>No storage buckets were found.</div>
			} else {
				<table class="data-table"><thead><tr><th>Bucket</th><th>Pool</th><th>S3 URL</th></tr></thead><tbody>
					for _, bucket := range state.Buckets {
						<tr><td><strong>{ bucket.Name }</strong></td><td>{ bucket.Pool }</td><td>{ bucket.S3URL }</td></tr>
					}
				</tbody></table>
			}
		</article>
	</div>
}

templ imageAction(project, fingerprint, action, csrf string, disabled bool, title string) {
	<form method="post" action={ templ.SafeURL("/incus/images/" + fingerprint + "/" + action) } hx-boost="false">
		<input type="hidden" name="csrf" value={ csrf }/>
		<input type="hidden" name="project" value={ project }/>
		<button class="icon-button danger" type="submit" disabled?={ disabled } title={ title } aria-label="Delete image">@web.Icon("trash")</button>
	</form>
}

templ instanceAction(project, name, action, label, csrf, class string) {
	<form method="post" action={ templ.SafeURL("/incus/instances/" + name + "/" + action) } hx-boost="false">
		<input type="hidden" name="csrf" value={ csrf }/>
		<input type="hidden" name="project" value={ project }/>
		<button class={ "button", class } type="submit">{ label }</button>
	</form>
}

templ DetailPage(detail Detail, csrf string, admin bool) {
	<div class="page-stack">
		<div class="page-intro">
			<div>
				<h2>{ detail.Instance.Name }</h2>
				<p>{ detail.Instance.Type } in the { detail.Project } project.</p>
			</div>
			<div class="actions">
				<a class="button secondary" href={ logsLink(detail.Project, detail.Instance.Name, SourceConsole) }>View logs</a>
				<a class="button secondary" href={ projectLink(detail.Project) }>Back to Incus</a>
			</div>
		</div>
		<section class="engine-stats" aria-label="Instance summary">
			<div class="engine-stat">
				<span>Status</span>
				if detail.Instance.Running {
					<strong>Running</strong>
				} else {
					<strong>{ stateLabel(detail.Instance) }</strong>
				}
				<small>{ uptimeLabel(detail.Instance) }</small>
			</div>
			<div class="engine-stat"><span>Memory</span><strong>{ memoryLabel(detail.Instance) }</strong><small>{ memoryTotalLabel(detail) }</small></div>
			<div class="engine-stat"><span>Processes</span><strong>{ processLabel(detail.Instance) }</strong><small>{ cpuLabel(detail.Instance) }</small></div>
			<div class="engine-stat"><span>Architecture</span><strong>{ firstValue(detail.Architecture) }</strong><small>{ countLabel(len(detail.Snapshots), "snapshot") }</small></div>
		</section>
		if admin {
			<article class="card">
				<div class="card-heading split">
					<div><h2>Lifecycle</h2><p>Actions are recorded in Activity.</p></div>
					<div class="actions">
						if detail.Instance.Running {
							@instanceAction(detail.Project, detail.Instance.Name, "restart", "Restart", csrf, "secondary")
							@instanceAction(detail.Project, detail.Instance.Name, "stop", "Stop", csrf, "danger")
							@instanceAction(detail.Project, detail.Instance.Name, "stop-force", "Force stop", csrf, "danger")
						} else {
							@instanceAction(detail.Project, detail.Instance.Name, "start", "Start", csrf, "")
							@instanceAction(detail.Project, detail.Instance.Name, "remove", "Remove", csrf, "danger")
						}
					</div>
				</div>
			</article>
		}
		<article class="card table-card">
			<div class="table-toolbar"><h2>Network</h2><span>{ countLabel(len(detail.Networks), "interface") }</span></div>
			if len(detail.Networks) == 0 {
				<div class="empty-state">No interface state is reported. A stopped instance has none.</div>
			} else {
				<table class="data-table"><thead><tr><th>Interface</th><th>Addresses</th><th>Hardware address</th><th>MTU</th><th>State</th></tr></thead><tbody>
					for _, item := range detail.Networks {
						<tr>
							<td><strong>{ item.Name }</strong></td>
							<td>{ joinValues(item.Addresses) }</td>
							<td><span class="version">{ firstValue(item.HWAddr) }</span></td>
							<td>{ fmt.Sprint(item.MTU) }</td>
							<td><span class="badge">{ firstValue(item.State) }</span></td>
						</tr>
					}
				</tbody></table>
			}
		</article>
		<article class="card table-card">
			<div class="table-toolbar"><h2>Snapshots</h2><span>{ fmt.Sprintf("%d total", len(detail.Snapshots)) }</span></div>
			if admin {
				<form class="page-intro" method="post" action={ snapshotCreateLink(detail.Instance.Name) } hx-boost="false">
					<input type="hidden" name="csrf" value={ csrf }/>
					<input type="hidden" name="project" value={ detail.Project }/>
					<label for="incus-snapshot-name">New snapshot</label>
					<input id="incus-snapshot-name" name="snapshot" type="text" required maxlength="63" placeholder="nightly"/>
					<button class="button" type="submit">Create snapshot</button>
				</form>
				<p class="card-subtle">Snapshots are never stateful: a running instance's memory is not captured, and an instance must be stopped before a snapshot can be restored.</p>
			}
			if len(detail.Snapshots) == 0 {
				<div class="empty-state">
					<span class="card-icon orange">@web.Icon("incus")</span>
					No snapshots exist for this instance.
				</div>
			} else {
				<table class="data-table"><thead><tr><th>Snapshot</th><th>Created</th><th>Expires</th><th>Stateful</th><th>Actions</th></tr></thead><tbody>
					for _, item := range detail.Snapshots {
						<tr>
							<td><strong>{ item.Name }</strong></td>
							<td>{ firstValue(item.CreatedAt) }</td>
							<td>{ firstValue(item.ExpiresAt, "Never") }</td>
							<td>
								if item.Stateful {
									<span class="badge active">Stateful</span>
								} else {
									<span class="badge">No</span>
								}
							</td>
							<td>
								<div class="actions">
									if !admin {
										<span class="card-subtle">No permission</span>
									} else {
										if detail.Instance.Running {
											<span class="card-subtle" title="Stop the instance before restoring a snapshot">Stop to restore</span>
										} else {
											@snapshotAction(detail.Project, detail.Instance.Name, item.Name, "restore", "Restore", csrf, "secondary")
										}
										@snapshotAction(detail.Project, detail.Instance.Name, item.Name, "delete", "Delete", csrf, "danger")
									}
								</div>
							</td>
						</tr>
					}
				</tbody></table>
			}
		</article>
		<article class="card table-card">
			<div class="table-toolbar"><h2>Devices</h2><span>{ countLabel(len(detail.Devices), "device") } attached</span></div>
			if len(detail.Devices) == 0 {
				<div class="empty-state">No devices are attached beyond the profile defaults.</div>
			} else {
				<table class="data-table"><thead><tr><th>Device</th><th>Type</th><th>Properties</th></tr></thead><tbody>
					for _, item := range detail.Devices {
						<tr>
							<td><strong>{ item.Name }</strong></td>
							<td>{ firstValue(item.Type) }</td>
							<td>{ entryLabel(item.Properties) }</td>
						</tr>
					}
				</tbody></table>
			}
		</article>
		<article class="card table-card">
			<div class="table-toolbar">
				<h2>Configuration</h2>
				<span>Reviewed keys only</span>
			</div>
			<div class="page-intro">
				<p>Pilothouse reports a fixed set of shape and posture keys. Cloud-init payloads, environment variables, and raw passthrough configuration are never read from the instance.</p>
			</div>
			if len(detail.Config) == 0 {
				<div class="empty-state">This instance sets none of the reported configuration keys.</div>
			} else {
				<table class="data-table"><thead><tr><th>Key</th><th>Value</th></tr></thead><tbody>
					for _, item := range detail.Config {
						<tr><td><span class="version">{ item.Key }</span></td><td>{ item.Value }</td></tr>
					}
				</tbody></table>
			}
		</article>
		<article class="card table-card">
			<div class="table-toolbar"><h2>Profiles</h2><span>{ countLabel(len(detail.Profiles), "profile") } applied</span></div>
			if len(detail.Profiles) == 0 {
				<div class="empty-state">No profiles are applied to this instance.</div>
			} else {
				<div class="mini-list">
					for _, profile := range detail.Profiles {
						<div class="mini-row"><div><strong>{ profile }</strong></div></div>
					}
				</div>
			}
		</article>
	</div>
}

templ LogsView(logs Logs, unavailable bool) {
	<div class="page-stack">
		<div class="page-intro">
			<div><h2>{ logs.Name }</h2><p>{ sourceDescription(logs.Source) }</p></div>
			<div class="actions">
				<a class="button secondary" href={ logsLink(logs.Project, logs.Name, sourceAlternate(logs.Source)) }>{ sourceLabel(sourceAlternate(logs.Source)) }</a>
				<a class="button secondary" href={ instanceLink(logs.Project, logs.Name) }>Back to instance</a>
			</div>
		</div>
		<article id="instance-logs" class="card table-card" hx-get={ logsLink(logs.Project, logs.Name, logs.Source) } hx-trigger="every 5s" hx-select="#instance-logs" hx-target="#instance-logs" hx-swap="outerHTML">
			<div class="table-toolbar"><h2>{ sourceLabel(logs.Source) }</h2><span>Last 200 lines</span></div>
			if unavailable {
				<div class="empty-state">{ unavailableLabel(logs.Source) }</div>
			} else if len(logs.Lines) == 0 {
				<div class="empty-state">No log output.</div>
			} else {
				<pre class="log-output">
					for _, line := range logs.Lines {
						{ line.Message }{ "\n" }
					}
				</pre>
			}
		</article>
	</div>
}

templ snapshotAction(project, instance, snapshot, action, label, csrf, class string) {
	<form method="post" action={ snapshotActionLink(instance, snapshot, action) } hx-boost="false">
		<input type="hidden" name="csrf" value={ csrf }/>
		<input type="hidden" name="project" value={ project }/>
		<button class={ "button", class } type="submit">{ label }</button>
	</form>
}
