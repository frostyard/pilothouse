{
  "schema_version": 2,
  "default_level": "L3",
  "paths": [
    {
      "glob": ".github/risk-paths.json",
      "level": "L2",
      "why": "governance: the high-risk path list"
    },
    {
      "glob": ".github/workflows/**",
      "level": "L2",
      "why": "governance: CI, the risk-paths caller and token permissions"
    },
    {
      "glob": "Makefile",
      "level": "L2",
      "why": "governance: the verify gate"
    },
    {
      "glob": "scripts/check-template.mjs",
      "level": "L2",
      "why": "governance: the template verification gate"
    },
    {
      "glob": "scripts/check-corrections.mjs",
      "level": "L2",
      "why": "governance: the corrections validation gate"
    },
    {
      "glob": "scripts/lib/**",
      "level": "L2",
      "why": "governance: the vendored risk-path validator and matcher"
    },
    {
      "glob": "mise.toml",
      "level": "L1",
      "why": "update verification: the tool pins that CI installs"
    },
    {
      "glob": "mise.lock",
      "level": "L1",
      "why": "update verification: the checksums of the tools that CI installs"
    },
    {
      "glob": ".svu.yml",
      "level": "L1",
      "why": "publication: the version configuration for release tags"
    },
    {
      "glob": ".goreleaser.yaml",
      "level": "L1",
      "why": "publication: the build and package definitions GoReleaser runs"
    },
    {
      "glob": "scripts/bump.sh",
      "level": "L1",
      "why": "publication: creates and pushes the version tag"
    },
    {
      "glob": "packaging/**",
      "level": "L1",
      "why": "auth: systemd units, PAM stacks, sysusers and the root postinstall script"
    },
    {
      "glob": "cmd/pilothoused/**",
      "level": "L1",
      "why": "auth: the root broker executable"
    },
    {
      "glob": "internal/broker/**",
      "level": "L1",
      "why": "auth: the broker protocol and its fixed queries and actions"
    },
    {
      "glob": "internal/auth/**",
      "level": "L1",
      "why": "auth: PAM login and session handling"
    }
  ]
}
